% --- ANGLE 2: coding theory (expansion-code minimum distance) ---

@misc{jutla2005code,
  author = {Jutla, Charanjit S. and Patthak, Anindya C.},
  title  = {A Simple and Provably Good Code for {SHA} Message Expansion},
  year   = {2005},
  note   = {IACR ePrint 2005/247 (also circulated as ``Provably Good Codes for Hash
            Function Design''). Computer-assisted lower bounds on the minimum
            distance of the linear SHA message-expansion code: a modified
            expansion has min distance $\geq 82$ in the last 64 of 80 expanded
            words ($\geq 75$ / $\geq 52$ in the last 60 / 48). The ORIGINAL SHA-1
            expansion has min weight $\leq 44$ (only $\approx 30$ in the last 64
            words) --- the slack that enabled the $2^{69}$ differential attack.},
  url    = {https://eprint.iacr.org/2005/247},
  howpublished = {Cryptology ePrint Archive, Paper 2005/247}
}

